# Copy to .env. Everything works with the defaults; keys only unlock more.

# true = no outbound calls; canned Hackney data for any postcode. Good for UI work.
DEMO_MODE=false

# Address lookup (postcode -> list of addresses with UPRN). Without one, users type a
# house number and councils that need a UPRN fall back to manual entry.
#   os_places  https://osdatahub.os.uk  (OS Places API; free tier)
#   getaddress https://getaddress.io
ADDRESS_PROVIDER=none
OS_PLACES_API_KEY=
GETADDRESS_API_KEY=

# WhatsApp. stub = log + outbox table only.
MESSAGE_PROVIDER=stub
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=whatsapp:+14155238886
META_TOKEN=
META_PHONE_NUMBER_ID=

# Scraping
SCRAPE_TIMEOUT_SECONDS=90
REFRESH_INTERVAL_DAYS=7
REFRESH_WINDOW_DAYS_BEFORE_HOLIDAY=21
HORIZON_DAYS=90
# Postcode splits only log "would_split" until this is false (they move and message residents)
SPLIT_DRY_RUN=true

PUBLIC_BASE_URL=http://localhost:8000
