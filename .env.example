# Copy to .env. Everything works with the defaults; keys only unlock more.

# true = no outbound calls; canned Hackney data for any postcode. Good for UI work.
DEMO_MODE=false

# Address lookup (postcode -> list of addresses with UPRN). Without one, users type a
# house number and councils that need a UPRN fall back to neighbours or manual entry.
#   os_places        https://osdatahub.os.uk  (OS Places API; free tier)
#   ideal_postcodes  https://ideal-postcodes.co.uk  (pay per lookup; includes UPRN)
# The fallback is only called when the main provider fails or returns nothing.
# (getAddress.io closed on 4 Feb 2026; don't use it.)
ADDRESS_PROVIDER=os_places
ADDRESS_FALLBACK=ideal_postcodes
OS_PLACES_API_KEY=
IDEAL_POSTCODES_API_KEY=

# WhatsApp. stub = log + outbox table only.
MESSAGE_PROVIDER=stub
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=whatsapp:+14155238886
META_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=

# Scraping
SCRAPE_TIMEOUT_SECONDS=90
REFRESH_INTERVAL_DAYS=7
REFRESH_WINDOW_DAYS_BEFORE_HOLIDAY=21
HORIZON_DAYS=90

PUBLIC_BASE_URL=http://localhost:8000
