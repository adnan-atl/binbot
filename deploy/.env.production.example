# Copy to deploy/.env.production and fill in every value marked REQUIRED.
#   cp deploy/.env.production.example deploy/.env.production && nano deploy/.env.production
# Never commit the filled-in file.

# ---- Site --------------------------------------------------------------------------------
# REQUIRED: the domain this server answers on (DNS A record -> the server's static IP)
DOMAIN=binjamin.uk
# REQUIRED: same domain with https://, used in links and WhatsApp messages
PUBLIC_BASE_URL=https://binjamin.uk
BRAND_NAME=Binjamin
# The home page design (web/designs/<name>.html); empty = web/index.html
HOME_DESIGN=silly
PARENT_NAME=Alfred
PARENT_URL=https://alfred.co.uk
PRIVACY_URL=https://binjamin.uk/privacy
TERMS_URL=https://binjamin.uk/terms
APP_ENV=production
DEMO_MODE=false

# ---- Database ----------------------------------------------------------------------------
# REQUIRED: pick a long random password (e.g. `openssl rand -hex 24`) and use it in both places
POSTGRES_USER=binny
POSTGRES_PASSWORD=change-me
POSTGRES_DB=binny
DATABASE_URL=postgresql+psycopg://binny:change-me@db:5432/binny

# ---- WhatsApp (Meta Cloud API) -------------------------------------------------------------
MESSAGE_PROVIDER=meta
# REQUIRED: permanent System User token with whatsapp_business_messaging permission
META_TOKEN=
# REQUIRED: WhatsApp Manager -> Phone numbers -> Phone number ID
META_PHONE_NUMBER_ID=
# REQUIRED: the business number residents message, in E.164 (+447...)
META_DISPLAY_NUMBER=
# REQUIRED: any long random string; paste the same one into the Meta webhook settings
META_VERIFY_TOKEN=
# REQUIRED: app dashboard -> App settings -> Basic -> App secret (webhook signatures)
META_APP_SECRET=
# Approved templates (docs/whatsapp-templates.md)
META_REMINDER_TEMPLATE=bin_reminder
META_CHANGE_TEMPLATE=bin_day_changed
# Optional: the reminder with referral news (docs/whatsapp-templates.md). Leave empty until Meta approves it.
META_REMINDER_NEWS_TEMPLATE=
# "Share with neighbours" nudge (docs/whatsapp-templates.md §4): set to bin_share once approved
META_SHARE_TEMPLATE=
META_TEMPLATE_LANG=en_GB

# ---- Addresses ---------------------------------------------------------------------------
ADDRESS_PROVIDER=os_places
ADDRESS_FALLBACK=ideal_postcodes
# REQUIRED: OS Places API key (osdatahub.os.uk)
OS_PLACES_API_KEY=
# Recommended: Ideal Postcodes key, used when OS Places fails
IDEAL_POSTCODES_API_KEY=

# ---- Councils ----------------------------------------------------------------------------
# Browser sessions for councils that need one; keep equal to SE_NODE_MAX_SESSIONS in the compose file
BROWSER_SESSIONS=2
SCRAPE_TIMEOUT_SECONDS=90
REFRESH_INTERVAL_DAYS=7
REFRESH_WINDOW_DAYS_BEFORE_HOLIDAY=21
HORIZON_DAYS=90
# Postcode splits only log what they would do until this is false
SPLIT_DRY_RUN=true

# ---- Protection --------------------------------------------------------------------------
# Per-connection limits on postcode lookups and sign-ups. Leave on.
RATE_LIMITS=true
# Optional: IPs or ranges that skip the limits (the office, for testing), comma-separated
RATE_LIMIT_ALLOW=
# Recommended: Cloudflare Turnstile bot check on address lookup and sign-up (free).
# Cloudflare dashboard -> Turnstile -> Add widget, hostname binjamin.uk, mode Managed.
# Leave both empty to switch the check off.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# ---- Monitoring --------------------------------------------------------------------------
# Recommended: a healthchecks.io check URL. The worker pings it every minute after sending
# reminders (and /fail when sends fail), so you get an email if reminders stop.
HEARTBEAT_URL=

# ---- Off-server backups ------------------------------------------------------------------
# Recommended: copy the daily backups to an S3 bucket (deploy/README.md, "Off-server backups").
# Use the upload-only key made for this, never your own AWS keys.
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=eu-west-2
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
# Optional: a second healthchecks.io check (period 1 day, grace 12 hours) for the copy
BACKUP_HEARTBEAT_URL=

# ---- Error alerts ------------------------------------------------------------------------
# Recommended: a Sentry project DSN (sentry.io, pick the EU data region when signing up).
# Unexpected errors in the site and worker get emailed; residents' details are stripped first.
SENTRY_DSN=
